{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "fworch-case",
  "version": "0.1.0",
  "description": "案例库编排器。维护飞书 wiki 三层案例库 + Base 元数据，按关键词/专业领域检索案例， 新增/更新案例时搜索整理生成正文，fetch 案例主文档内容注入课程上下文。 内容规范（schema/起名/正文模版）见 fwstd-case。 用法：用户说\"案例库\"/\"案例\"/\"补充案例\"/\"推荐案例\"/\"新增案例\"触发",
  "author": {
    "name": "mengfanchun2017"
  },
  "homepage": "https://github.com/mengfanchun2017/skill",
  "repository": "https://github.com/mengfanchun2017/skill",
  "license": "MIT",
  "keywords": [
    "f"
  ],
  "userConfig": {
    "case_base_token": {
      "type": "string",
      "title": "案例库 Base token",
      "description": "多维表格 base token"
    }
  }
}
