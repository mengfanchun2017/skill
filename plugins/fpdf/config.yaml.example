# fpdf 配置模板
#
# 按你怎么装的选一种（不改本 template 文件本身）：
#
# A) /plugin install 装的（cache 副本随更新替换，别写进 cache）：
#    把本文件内容抄到 ~/.claude/skill-config/fpdf.yaml，填值。该路径在 cache 之外，
#    /plugin update 不会碰它。
#
# B) 自己 git clone 装的：
#    复制本文件为同目录的 config.yaml，填值。config.yaml 已在 .gitignore 里，
#    不会被提交。
#
# ccconfig 用户：
#   真实值放 ccprivate/skill/fpdf.yaml，apply-config.sh 自动把它 symlink 成
#   <skill目录>/config.yaml —— 两条路径是同一个文件，改哪边都行。

# 所有输出文档的父 wiki 节点 token（从父文档 URL 的 /wiki/<token> 取）
# 留空则创建的文档落在飞书云空间根目录，且不便于统一归档。
wiki_nodes:
  default: ""

# MinerU token（默认 precision 档必需；不填只能跑 flash 档，无结构、不能排版）
# 获取：https://mineru.net → API 管理 → 建 token
# 也可放在独立文件里（优先级：$MINERU_CONF > $FPDF_CONFIG
# > ~/.claude/skill-config/fpdf.yaml > 本文件 > $CCPRIVATE_HOME/conf/mineru.json
# > ~/git/ccprivate/conf/mineru.json）
mineru:
  token: ""

# 文档索引（自动追加，勿手改）
doc_index: []